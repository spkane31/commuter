# Copy to /etc/commuter/commuter.env and replace the blank values.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
COMMUTER_BASE_URL=http://127.0.0.1:8000
COMMUTER_DATABASE_PATH=/var/lib/commuter/commuter.db
# Optional training export. Share the workbook with the service account.
COMMUTER_SHEETS_ENABLED=false
COMMUTER_SPREADSHEET_ID=
COMMUTER_ACTIVITY_SHEET=RAW DATA
GOOGLE_APPLICATION_CREDENTIALS=
COMMUTER_TRAINING_CACHE_DIR=/var/lib/commuter/training-cache
COMMUTER_REPORTING_TIMEZONE=America/Denver
COMMUTER_TRAINING_RECENT_DAYS=7
COMMUTER_TRAINING_MAX_ACTIVITIES=5
COMMUTER_TRAINING_TIME_BUDGET_S=90
# Default: max(3s, three median recording intervals). A value here overrides cadence.
COMMUTER_TRAINING_MAX_GAP_S=
# Optional Temporal Cloud event worker. Required only for webhook processing.
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
# Cloudflare Queues HTTP pull API. Queue name is configured in wrangler.jsonc;
# obtain the opaque queue ID from the Cloudflare dashboard/API.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_QUEUE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_QUEUE_POLL_INTERVAL_S=5
CLOUDFLARE_QUEUE_RETRY_DELAY_S=15
CLOUDFLARE_QUEUE_VISIBILITY_TIMEOUT_MS=60000

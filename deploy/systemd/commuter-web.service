[Unit]
Description=Commuter local Strava administration service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=__COMMUTER_SERVICE_USER__
Group=__COMMUTER_SERVICE_GROUP__
WorkingDirectory=__COMMUTER_PROJECT_ROOT__
EnvironmentFile=/etc/commuter/commuter.env
Environment=PYTHONUNBUFFERED=1
ExecStart=__COMMUTER_PROJECT_ROOT__/.venv/bin/commuter
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=true

[Install]
WantedBy=multi-user.target

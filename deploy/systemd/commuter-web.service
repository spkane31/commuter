[Unit]
Description=Commuter local Strava administration service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=commuter
Group=commuter
WorkingDirectory=/opt/commuter
EnvironmentFile=/etc/commuter/commuter.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/commuter/.venv/bin/commuter
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/commuter

[Install]
WantedBy=multi-user.target

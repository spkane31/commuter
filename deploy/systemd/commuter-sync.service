[Unit]
Description=Commuter Strava ride poller
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=__COMMUTER_SERVICE_USER__
Group=__COMMUTER_SERVICE_GROUP__
WorkingDirectory=__COMMUTER_PROJECT_ROOT__
EnvironmentFile=/etc/commuter/commuter.env
Environment=PYTHONUNBUFFERED=1
ExecStart=__COMMUTER_PROJECT_ROOT__/.venv/bin/commuter sync
TimeoutStartSec=2min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/commuter

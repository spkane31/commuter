{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "commuter-strava-webhook",
    "main": "cloudflare/strava-webhook/src/index.ts",
    "compatibility_date": "2026-10-11",
    "workers_dev": true,
    "keep_vars": true,
    "secrets": {
        "required": [
            "STRAVA_VERIFY_TOKEN"
        ]
    },
    "queues": {
        "producers": [
            {
                "binding": "commuter",
                "queue": "commuter"
            }
        ]
    },
    "observability": {
        "enabled": true,
        "logs": {
            "enabled": true,
            "invocation_logs": true
        }
    }
}

{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "commuter-strava-webhook",
    "main": "cloudflare/strava-webhook/src/index.ts",
    "compatibility_date": "2026-10-11",
    "workers_dev": true,
    "secrets": {
        "required": [
            "STRAVA_VERIFY_TOKEN",
            "TEMPORAL_API_KEY"
        ]
    },
    "observability": {
        "enabled": true,
        "logs": {
            "enabled": true,
            "invocation_logs": true
        }
    }
}